# Copy to .env (never commit the real one). Loaded/validated by src/config/app-config.ts — the API refuses to start if a required value is missing or weak.
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0   # must be a replica set (ledger transactions)
MONGODB_DB=jewellery-erp

# >= 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

ALLOWED_ORIGINS=http://localhost:3000   # comma-separated; used for CORS and the cookie-endpoint CSRF origin check
APP_BASE_URL=http://localhost:3000      # base of password-reset links
COOKIE_SECURE=false                     # defaults to true in production
TRUST_PROXY=false                       # true only when behind a reverse proxy (so rate limiting sees the real client IP)

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_IDLE_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
RATE_LIMIT_ENABLED=true

# Product images. Local disk is for dev / single node; production should swap in an S3 adapter (modules/media/storage.ts).
MEDIA_DIR=./.data/media
# Absolute URL browsers use to reach this API (defaults to http://localhost:$PORT)
# API_PUBLIC_URL=

# First super admin (pnpm --filter @jewellery/api bootstrap-admin) — refuses if one already exists.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
